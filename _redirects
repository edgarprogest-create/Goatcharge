# Cloudflare Pages SPA fallback
# Every /s/<qrcode> URL serves index.html — the webapp reads the QR from the URL on load.
/s/*  /index.html  200

# Partners page (Cloudflare serves parceiros.html at /parceiros automatically)
/partners   /parceiros  301
/socios     /parceiros  301

# Bare domain → root
/     /index.html  200
